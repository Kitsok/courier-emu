  "benchmark_source": "import hashlib,json,struct,time,sys\nfrom courier_emu.dsp import NativeC5x\npatterns={'primary':[0x7801], 'be':[0xbe00,0xbe01,0xbe02,0xbe03,0xbe04,0xbe05],\n          'bf':[0xbf08,1,0xbf09,2,0xbf0a,3,0xbf0b,4]}\nresults={}\nfor name,pattern in patterns.items():\n    words=(pattern*((65536+len(pattern)-1)//len(pattern)))[:65536]\n    # Keep two-word operands aligned at the wrap.\n    program=struct.pack('<65536H',*words)\n    times=[];states=[]\n    for _ in range(1):\n        with NativeC5x.from_program(0,program) as core:\n            core.step_cycles(10000)\n            start=time.process_time();core.step_cycles(5000000);times.append(time.process_time()-start)\n            states.append(core.state())\n    assert all(state==states[0] for state in states)\n    results[name]={'cpu_seconds':times,'state':states[0]}\nprint(json.dumps(results))\n"
}
